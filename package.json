  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run frontend:dev\"",
    "server": "cross-env NODE_OPTIONS=\"--use-system-ca\" tsx server.ts",
    "start": "cross-env NODE_OPTIONS=\"--use-system-ca\" tsx openai-client.ts",
    "cli": "cross-env NODE_OPTIONS=\"--use-system-ca\" tsx openai-client.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "build": "npm run frontend:build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
